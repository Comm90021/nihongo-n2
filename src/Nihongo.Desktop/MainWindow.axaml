<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nihongo.Desktop.MainWindow"
        Title="Ôn N2"
        Width="1320" Height="840" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, Yu Gothic UI, Meiryo UI"
        FontSize="15"
        Foreground="{DynamicResource Ink}"
        Background="{DynamicResource PageBg}">
  <DockPanel>
    <!-- Dải biểu tượng: rộng 84 (có chữ) hoặc 64 (thu gọn, Ctrl+B) -->
    <Border x:Name="NavPane" DockPanel.Dock="Left" Width="84" Padding="8,18,8,12"
            Background="{DynamicResource NavBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Button x:Name="NavToggle" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,16"
                Width="40" Height="40" Padding="0" CornerRadius="12" BorderThickness="0"
                Background="{StaticResource Accent}" Click="OnNavToggle" ToolTip.Tip="Thu gọn / mở rộng thanh bên (Ctrl+B)">
          <TextBlock Text="N2" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>
        <ListBox x:Name="Nav" Classes="nav" Background="Transparent" SelectionChanged="OnNav" />
      </DockPanel>
    </Border>
    <Grid Margin="32,24,32,20">
      <ContentControl x:Name="Host" />
      <ContentControl x:Name="GeminiSlot" IsVisible="False" />
    </Grid>
  </DockPanel>
</Window>
