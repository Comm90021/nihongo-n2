<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nihongo.Desktop.MainWindow"
        Title="Ôn N2"
        Width="1320" Height="840" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, Yu Gothic UI, Meiryo UI"
        FontSize="15"
        Foreground="{DynamicResource Ink}"
        Background="{DynamicResource PageBg}">
  <DockPanel>
    <Border x:Name="NavPane" DockPanel.Dock="Left" Width="220" Padding="14,18" Background="{DynamicResource NavBg}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,22">
          <Button x:Name="NavToggle" Classes="ghost" Padding="10,8" Click="OnNavToggle" ToolTip.Tip="Thu gọn / mở rộng thanh bên (Ctrl+B)" />
          <StackPanel x:Name="Brand" VerticalAlignment="Center">
            <TextBlock Text="Ôn N2" FontSize="19" FontWeight="Bold" />
            <TextBlock Text="JLPT · 06/12/2026" FontSize="12" Opacity="0.6" />
          </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="Footer" Opacity="0.55" FontSize="11.5" TextWrapping="Wrap" Margin="6,0" />
        <ListBox x:Name="Nav" Classes="nav" Background="Transparent" SelectionChanged="OnNav" />
      </DockPanel>
    </Border>
    <Grid Margin="28,22">
      <ContentControl x:Name="Host" />
      <ContentControl x:Name="GeminiSlot" IsVisible="False" />
    </Grid>
  </DockPanel>
</Window>
